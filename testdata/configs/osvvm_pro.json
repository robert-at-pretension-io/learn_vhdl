{
  "standard": "2008",
  "analysis": {
    "cache": {
      "enabled": false
    },
    "requireLibraryMapping": false,
    "useProLibraries": true,
    "maxParallelFiles": 4
  },
  "lint": {
    "rules": {
      "rule_skipped": "info",
      "unresolved_type_mark": "off",
      "unresolved_unqualified_call": "off",
      "unresolved_subprogram": "off",
      "ambiguous_subprogram": "off",
      "ambiguous_unqualified_call": "off",
      "unresolved_dependency": "off",
      "unresolved_import": "off",
      "unresolved_library": "off",
      "unresolved_package": "off"
    }
  },
  "libraries": {
    "osvvm": {
      "files": [
        "**/*.vhd",
        "**/*.vhdl"
      ]
    }
  }
}
