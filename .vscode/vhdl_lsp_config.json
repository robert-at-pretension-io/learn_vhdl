{
  "standard": "2008",
  "libraries": {
    "work": {
      "files": [
        "*.vhd",
        "*.vhdl",
        "src/**/*.vhd",
        "src/**/*.vhdl",
        "rtl/**/*.vhd",
        "rtl/**/*.vhdl",
        "hdl/**/*.vhd",
        "hdl/**/*.vhdl",
        "tb/**/*.vhd",
        "tb/**/*.vhdl",
        "sim/**/*.vhd",
        "sim/**/*.vhdl",
        "test/**/*.vhd",
        "test/**/*.vhdl",
        "tests/**/*.vhd",
        "tests/**/*.vhdl",
        "testdata/**/*.vhd",
        "testdata/**/*.vhdl"
      ]
    }
  },
  "lint": {
    "rules": {
      "active_low_naming": "warning",
      "ambiguous_subprogram": "warning",
      "architecture_has_entity": "warning",
      "architecture_naming_convention": "warning",
      "async_reset_active_high": "warning",
      "async_reset_naming": "warning",
      "async_reset_unsynchronized": "warning",
      "bidirectional_port": "warning",
      "buffer_port": "warning",
      "cdc_insufficient_sync": "warning",
      "cdc_unsync_multi_bit": "warning",
      "cdc_unsync_single_bit": "warning",
      "clock_gating_opportunity": "warning",
      "clock_not_std_logic": "warning",
      "comb_process_no_default": "warning",
      "combinational_default_values": "warning",
      "combinational_feedback": "warning",
      "combinational_incomplete_assignment": "warning",
      "combinational_multiplier": "warning",
      "combinational_reset": "warning",
      "combinational_reset_gen": "warning",
      "complex_process": "warning",
      "component_resolved": "warning",
      "conditional_assignment_review": "warning",
      "configuration_missing_entity": "warning",
      "constant_if_condition": "warning",
      "constant_port_connection": "warning",
      "counter_trigger": "warning",
      "critical_signal_no_reset": "warning",
      "cross_process_combinational_loop": "warning",
      "dead_generate": "warning",
      "deep_generate_nesting": "warning",
      "direct_combinational_loop": "warning",
      "dsp_candidate_no_control": "warning",
      "duplicate_architecture_in_library": "warning",
      "duplicate_architecture_name": "warning",
      "duplicate_entity_in_file": "warning",
      "duplicate_port_in_entity": "warning",
      "duplicate_signal_in_entity": "warning",
      "duplicate_signal_name": "warning",
      "duplicate_use_clause": "warning",
      "empty_architecture": "warning",
      "empty_port_map": "warning",
      "empty_sensitivity_combinational": "warning",
      "entity_has_ports": "warning",
      "entity_name_with_numbers": "warning",
      "entity_naming": "warning",
      "entity_no_ports_not_tb": "warning",
      "entity_port_not_connected": "warning",
      "entity_without_arch": "warning",
      "enum_case_incomplete": "warning",
      "file_entity_mismatch": "warning",
      "floating_instance_input": "warning",
      "fsm_missing_default_state": "warning",
      "fsm_no_reset_state": "warning",
      "fsm_unhandled_state": "warning",
      "fsm_unreachable_state": "warning",
      "function_body_missing": "warning",
      "function_param_invalid_mode": "warning",
      "gated_clock_detection": "warning",
      "generate_range_mismatch": "warning",
      "generic_without_default": "warning",
      "hardcoded_generic": "warning",
      "hardcoded_port_value": "warning",
      "incomplete_case_latch": "warning",
      "inout_as_input": "warning",
      "inout_as_output": "warning",
      "input_port_driven": "warning",
      "instance_name_matches_component": "warning",
      "instance_naming_convention": "warning",
      "inverted_trigger": "warning",
      "large_combinational_process": "warning",
      "large_entity": "warning",
      "large_literal_comparison": "warning",
      "large_package": "warning",
      "legacy_packages": "warning",
      "long_sensitivity_list": "warning",
      "long_signal_name": "warning",
      "magic_number_comparison": "warning",
      "magic_width_number": "warning",
      "many_instances": "warning",
      "many_signals": "warning",
      "mismatched_tb_architecture": "warning",
      "missing_clock_sensitivity": "warning",
      "missing_reset": "warning",
      "missing_reset_sensitivity": "warning",
      "mixed_edge_clocking": "warning",
      "mixed_port_directions": "warning",
      "mixed_signedness": "warning",
      "multi_driven_signal": "warning",
      "multi_trigger_process": "warning",
      "multiple_clock_domains": "warning",
      "multiple_clocks_in_process": "warning",
      "multiple_entities_per_file": "warning",
      "naming_convention": "warning",
      "numeric_std_unsigned_mixing": "warning",
      "open_port_connection": "warning",
      "partial_reset_domain": "warning",
      "port_type_mismatch_style": "warning",
      "port_width_mismatch": "warning",
      "positional_mapping": "warning",
      "potential_combinational_loop": "warning",
      "potential_latch": "warning",
      "potential_memory_inference": "warning",
      "potential_overflow": "warning",
      "power_hotspot": "warning",
      "procedure_body_missing": "warning",
      "procedure_param_invalid_mode": "warning",
      "process_label_missing": "warning",
      "process_with_no_statements": "warning",
      "record_field_unused": "warning",
      "redundant_others_only": "warning",
      "repeated_component_instantiation": "warning",
      "reset_crosses_domains": "warning",
      "reset_not_std_logic": "warning",
      "rule_skipped": "warning",
      "selected_assignment_review": "warning",
      "sensitivity_list_incomplete": "warning",
      "sensitivity_list_superfluous": "warning",
      "sequential_signal_no_reset": "warning",
      "shared_variable_usage": "warning",
      "short_port_name": "warning",
      "short_reset_sync": "warning",
      "short_signal_name": "warning",
      "signal_crosses_clock_domain": "warning",
      "signal_fanout": "warning",
      "signal_in_seq_and_comb": "warning",
      "signal_input_naming": "warning",
      "signal_output_naming": "warning",
      "single_state_signal": "warning",
      "sparse_port_map": "warning",
      "state_signal_not_enum": "warning",
      "tb_with_synth_arch": "warning",
      "testbench_with_ports": "warning",
      "three_stage_combinational_loop": "warning",
      "trigger_drives_output": "warning",
      "trivial_architecture": "warning",
      "two_stage_combinational_loop": "warning",
      "undeclared_signal_usage": "warning",
      "undriven_output_port": "warning",
      "undriven_signal": "warning",
      "unguarded_division": "warning",
      "unguarded_exponent": "warning",
      "unguarded_multiplication": "warning",
      "uninitialized_variable_read": "warning",
      "unlabeled_generate": "warning",
      "unregistered_output": "warning",
      "unresolved_dependency": "warning",
      "unresolved_import": "warning",
      "unresolved_library": "warning",
      "unresolved_package": "warning",
      "unresolved_subprogram": "warning",
      "unused_component": "warning",
      "unused_constant": "warning",
      "unused_generic": "warning",
      "unused_input_port": "warning",
      "unused_library_clause": "warning",
      "unused_signal": "warning",
      "unused_subprogram": "warning",
      "unused_subtype": "warning",
      "unused_type": "warning",
      "unused_use_clause": "warning",
      "unused_variable": "warning",
      "use_all_abuse": "warning",
      "variable_in_sensitivity_list": "warning",
      "variable_shadows_signal": "warning",
      "very_long_file": "warning",
      "very_wide_bus": "warning",
      "very_wide_register": "warning",
      "vhdl2008_sensitivity_all": "warning",
      "wait_in_clocked_process": "warning",
      "weak_guard": "warning",
      "wide_signal": "warning",
      "write_only_signal": "warning"
    },
    "ignoreRegions": true
  },
  "analysis": {
    "followLibraryUse": true,
    "resolveDefaultBinding": true,
    "requireLibraryMapping": true,
    "policyInputMode": "full",
    "cache": {
      "enabled": true,
      "dir": ".vhdl_lint_cache"
    }
  }
}
