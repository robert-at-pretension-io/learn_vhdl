1 sort bitvec 1
2 input 1 req
3 constd 1 0
4 state 1 ack
5 init 1 4 3
6 constd 1 0
7 state 1 
8 init 1 7 6
9 constd 1 0
10 state 1 
11 init 1 10 9
12 constd 1 -1
13 xor 1 7 12
14 or 1 13 2
15 constd 1 -1
16 xor 1 10 15
17 or 1 16 4
18 constraint 14
19 not 1 17
20 bad 19
21 next 1 4 2
22 next 1 7 2
23 next 1 10 2
module {
  hw.module @handshake(in %clk : !seq.clock, in %req : i1, out ack : i1) {
    %0 = seq.initial() {
      %false = hw.constant false
      seq.yield %false : i1
    } : () -> !seq.immutable<i1>
    %ack = seq.compreg %req, %clk initial %0 : i1  
    %1 = seq.initial() {
      %false = hw.constant false
      seq.yield %false : i1
    } : () -> !seq.immutable<i1>
    %2 = seq.compreg %req, %clk initial %1 : i1  
    %true = hw.constant true
    %3 = comb.xor %2, %true : i1
    %4 = comb.or %3, %req : i1
    %5 = seq.initial() {
      %false = hw.constant false
      seq.yield %false : i1
    } : () -> !seq.immutable<i1>
    %6 = seq.compreg %req, %clk initial %5 : i1  
    %true_0 = hw.constant true
    %7 = comb.xor %6, %true_0 : i1
    %8 = comb.or %7, %ack : i1
    verif.assume %4 : i1
    verif.assert %8 : i1
    hw.output %ack : i1
  }
}

