hw.module @test_fail_konami(in %clk: !seq.clock, in %rst: i1, in %up: i1, in %down: i1, in %left: i1, in %right: i1, out unlock: i1) {
  // --- Body ---
  %2 = hw.constant 1 : i1
  %0 = comb.icmp eq %rst, %2 : i1
  %3 = hw.constant 0 : i3
  %7 = hw.constant 0 : i3
  %5 = comb.icmp eq %state, %7 : i3
  %10 = hw.constant 1 : i1
  %8 = comb.icmp eq %up, %10 : i1
  %4 = comb.and %5, %8 : i1
  %11 = hw.constant 1 : i3
  %18 = hw.constant 1 : i1
  %16 = comb.icmp eq %up, %18 : i1
  %21 = hw.constant 1 : i1
  %19 = comb.icmp eq %down, %21 : i1
  %15 = comb.or %16, %19 : i1
  %24 = hw.constant 1 : i1
  %22 = comb.icmp eq %left, %24 : i1
  %14 = comb.or %15, %22 : i1
  %27 = hw.constant 1 : i1
  %25 = comb.icmp eq %right, %27 : i1
  %13 = comb.or %14, %25 : i1
  %28 = hw.constant 0 : i3
  %29 = comb.mux %13, %28, %state : i3
  %33 = hw.constant 5 : i3
  %31 = comb.icmp eq %state, %33 : i3
  %36 = hw.constant 1 : i1
  %34 = comb.icmp eq %right, %36 : i1
  %30 = comb.and %31, %34 : i1
  %37 = hw.constant 6 : i3
  %38 = comb.mux %30, %37, %29 : i3
  %42 = hw.constant 4 : i3
  %40 = comb.icmp eq %state, %42 : i3
  %45 = hw.constant 1 : i1
  %43 = comb.icmp eq %left, %45 : i1
  %39 = comb.and %40, %43 : i1
  %46 = hw.constant 5 : i3
  %47 = comb.mux %39, %46, %38 : i3
  %51 = hw.constant 3 : i3
  %49 = comb.icmp eq %state, %51 : i3
  %54 = hw.constant 1 : i1
  %52 = comb.icmp eq %down, %54 : i1
  %48 = comb.and %49, %52 : i1
  %55 = hw.constant 4 : i3
  %56 = comb.mux %48, %55, %47 : i3
  %60 = hw.constant 2 : i3
  %58 = comb.icmp eq %state, %60 : i3
  %63 = hw.constant 1 : i1
  %61 = comb.icmp eq %down, %63 : i1
  %57 = comb.and %58, %61 : i1
  %64 = hw.constant 3 : i3
  %65 = comb.mux %57, %64, %56 : i3
  %69 = hw.constant 1 : i3
  %67 = comb.icmp eq %state, %69 : i3
  %72 = hw.constant 1 : i1
  %70 = comb.icmp eq %up, %72 : i1
  %66 = comb.and %67, %70 : i1
  %73 = hw.constant 2 : i3
  %74 = comb.mux %66, %73, %65 : i3
  %75 = comb.mux %4, %11, %74 : i3
  %76 = comb.mux %0, %3, %75 : i3
  %77 = seq.initial () {
    %78 = hw.constant 0 : i3
    seq.yield %78 : i3
  } : () -> !seq.immutable<i3>
  %state = seq.compreg %76, %clk initial %77 : i3
  %81 = hw.constant 1 : i1
  %79 = comb.icmp eq %rst, %81 : i1
  %82 = hw.constant 0 : i1
  %83 = hw.constant 0 : i1
  %87 = hw.constant 0 : i3
  %85 = comb.icmp eq %state, %87 : i3
  %90 = hw.constant 1 : i1
  %88 = comb.icmp eq %up, %90 : i1
  %84 = comb.and %85, %88 : i1
  %97 = hw.constant 1 : i1
  %95 = comb.icmp eq %up, %97 : i1
  %100 = hw.constant 1 : i1
  %98 = comb.icmp eq %down, %100 : i1
  %94 = comb.or %95, %98 : i1
  %103 = hw.constant 1 : i1
  %101 = comb.icmp eq %left, %103 : i1
  %93 = comb.or %94, %101 : i1
  %106 = hw.constant 1 : i1
  %104 = comb.icmp eq %right, %106 : i1
  %92 = comb.or %93, %104 : i1
  %110 = hw.constant 5 : i3
  %108 = comb.icmp eq %state, %110 : i3
  %113 = hw.constant 1 : i1
  %111 = comb.icmp eq %right, %113 : i1
  %107 = comb.and %108, %111 : i1
  %114 = hw.constant 1 : i1
  %115 = comb.mux %107, %114, %83 : i1
  %119 = hw.constant 4 : i3
  %117 = comb.icmp eq %state, %119 : i3
  %122 = hw.constant 1 : i1
  %120 = comb.icmp eq %left, %122 : i1
  %116 = comb.and %117, %120 : i1
  %123 = comb.mux %116, %83, %115 : i1
  %127 = hw.constant 3 : i3
  %125 = comb.icmp eq %state, %127 : i3
  %130 = hw.constant 1 : i1
  %128 = comb.icmp eq %down, %130 : i1
  %124 = comb.and %125, %128 : i1
  %131 = comb.mux %124, %83, %123 : i1
  %135 = hw.constant 2 : i3
  %133 = comb.icmp eq %state, %135 : i3
  %138 = hw.constant 1 : i1
  %136 = comb.icmp eq %down, %138 : i1
  %132 = comb.and %133, %136 : i1
  %139 = comb.mux %132, %83, %131 : i1
  %143 = hw.constant 1 : i3
  %141 = comb.icmp eq %state, %143 : i3
  %146 = hw.constant 1 : i1
  %144 = comb.icmp eq %up, %146 : i1
  %140 = comb.and %141, %144 : i1
  %147 = comb.mux %140, %83, %139 : i1
  %148 = comb.mux %84, %83, %147 : i1
  %149 = comb.mux %79, %82, %148 : i1
  %150 = seq.initial () {
    %151 = hw.constant 0 : i1
    seq.yield %151 : i1
  } : () -> !seq.immutable<i1>
  %unlock = seq.compreg %149, %clk initial %150 : i1
  %155 = hw.constant 0 : i1
  %153 = comb.icmp eq %unlock, %155 : i1
  verif.assert %153 : i1
  hw.output %unlock : i1
}

