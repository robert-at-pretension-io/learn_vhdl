  %74 = comb.mux %66, %73, %65 : i3
  %75 = comb.mux %4, %11, %74 : i3
  %76 = comb.mux %0, %3, %75 : i3
  %state = seq.compreg %76, %clk : i3
  %79 = hw.constant 1 : i1
  %77 = comb.icmp eq %rst, %79 : i1
  %80 = hw.constant 0 : i1
  %81 = hw.constant 0 : i1
